{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        },
        {
          "type": "generic",
          "path": "main.py"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='l1nkzip')].version"
        }
      ]
    }
  }
}
